meta {
  name: 03 Get Todo
  type: http
  seq: 4
}

get {
  url: http://localhost:4000/api/todos/missing-todo-id
  body: none
  auth: none
}

script:pre-request {
  const todoId = bru.getVar("todoId");

  if (todoId) {
    req.setUrl(`http://localhost:4000/api/todos/${encodeURIComponent(todoId)}`);
  }
}

tests {
  test("returns 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns selected todo", function() {
    const body = res.getBody();
    expect(body.id).to.equal(bru.getVar("todoId"));
  });
}
