meta {
  name: 03 Get Todo
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/todos/{{todoId}}
  body: none
  auth: none
}

tests {
  test("returns 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns selected todo", function() {
    const body = res.getBody();
    expect(body.id).to.equal(bru.getEnvVar("todoId"));
  });
}
