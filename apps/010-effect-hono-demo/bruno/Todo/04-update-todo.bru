meta {
  name: 04 Update Todo
  type: http
  seq: 6
}

patch {
  url: http://localhost:4000/api/todos/missing-todo-id
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "title": "Learn Effect with Bruno - updated",
    "completed": true
  }
}

script:pre-request {
  const todoId = bru.getVar("todoId");

  if (todoId) {
    req.setUrl(`http://localhost:4000/api/todos/${encodeURIComponent(todoId)}`);
  }
}

tests {
  test("returns 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("updates todo", function() {
    const body = res.getBody();
    expect(body.completed).to.equal(true);
    expect(body.title).to.equal("Learn Effect with Bruno - updated");
  });
}
