meta {
  name: 06 Get Deleted Todo
  type: http
  seq: 8
}

get {
  url: http://localhost:4000/api/todos/missing-todo-id
  body: none
  auth: none
}

script:pre-request {
  const todoId = bru.getVar("todoId");

  if (todoId) {
    req.setUrl(`http://localhost:4000/api/todos/${encodeURIComponent(todoId)}`);
  }
}

tests {
  test("returns 404", function() {
    expect(res.getStatus()).to.equal(404);
  });
}
